# Copy to keystore.properties, fill in the real values, then:
#   chmod 600 keystore.properties
# Add keystore.properties (and the .jks itself) to .gitignore. Never commit
# either: a leaked keystore plus password is a leaked signing identity.

storeFile=/root/keys/release.jks
storePassword=change-me
keyAlias=release
keyPassword=change-me
