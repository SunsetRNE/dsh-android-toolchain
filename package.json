{
  "name": "dsh-android-toolchain",
  "version": "0.1.3",
  "description": "Shared Android/JVM toolchain provisioning plus a single-slot build broker (MCP server) for DeepSeek Harness on aarch64.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "android-broker": "bin/android-broker.mjs",
    "android-provision": "bin/android-provision.mjs",
    "android-build": "bin/android-build.mjs",
    "android-status": "bin/android-status.mjs",
    "android-doctor": "bin/android-doctor.mjs"
  },
  "files": [
    "AGENTS.md",
    "README.md",
    "bin",
    "cordis.patch.yml",
    "index.js",
    "scripts",
    "src",
    "toolchain.manifest.json"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "provision": "node bin/android-provision.mjs",
    "manifest:verify": "node bin/android-provision.mjs --verify-manifest",
    "postinstall": "node bin/android-provision.mjs --auto"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SunsetRNE/dsh-android-toolchain.git"
  },
  "keywords": [
    "dsh",
    "dsh-bundle",
    "mcp",
    "android",
    "gradle",
    "aarch64"
  ],
  "homepage": "https://github.com/SunsetRNE/dsh-android-toolchain#readme",
  "bugs": {
    "url": "https://github.com/SunsetRNE/dsh-android-toolchain/issues"
  }
}
