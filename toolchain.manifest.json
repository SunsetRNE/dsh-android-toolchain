      "provides": [
        "gradle"
      ],
      "notes": "Gradle runs on any host JVM; only the JVM must be arm64."
    },
    "kotlin": {
      "enabled": false,
      "version": "2.0.21",
      "source": "https://github.com/JetBrains/kotlin/releases/download/v2.0.21/kotlin-compiler-2.0.21.zip",
      "archive": "zip",
      "sha256": "",
      "provides": [
        "kotlinc"
      ],
      "notes": "Optional standalone compiler; Gradle's Kotlin plugin is usually enough."
    },
    "sdk": {
      "enabled": false,
      "version": "35.0.0",
      "source": "",
      "archive": "zip",
      "sha256": "",
      "provides": [
        "sdkmanager",
        "aapt2",
        "d8"
      ],
      "notes": "Official build-tools are linux-x86_64 ELF and cannot exec under aarch64 proot. Enable only with an arm64 build-tools archive you trust, and pin its sha256."
    },
    "ndk": {
      "enabled": false,
      "version": "",
      "source": "",
      "archive": "zip",
      "sha256": "",
